+    def reserve(self, required: int) -> None:
+        """Pre-size to at least *required* tokens; only valid while empty.
+
+        Dropping any existing buffers lets the next write lazily allocate at
+        the new size — one allocation at the exact target instead of the
+        doubling ladder, whose 131072→262144 step transiently holds old+new
+        buffers plus a copy across every attention layer (the observed 192K
+        prefill killer).
+        """
+        if required <= self.max_seq_len:
+            return
+        assert self.offset == 0, "reserve() requires an empty cache"
+        self.max_seq_len = required
+        self.keys = None
+        self.values = None
