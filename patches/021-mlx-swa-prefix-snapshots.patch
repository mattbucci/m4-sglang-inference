diff --git a/python/sglang/srt/hardware_backend/mlx/swa_prefix.py b/python/sglang/srt/hardware_backend/mlx/swa_prefix.py
new file mode 100644
index 0000000000..7ba7745ec7
--- /dev/null
+++ b/python/sglang/srt/hardware_backend/mlx/swa_prefix.py
@@ -0,0 +1,50 @@
+"""Prefix reuse for sliding-window attention on the MLX backend.
+
+The MLX attention KV pool stores full-attention KV only; a sliding-window
+layer keeps a per-request ``WindowedAttentionKVCache`` holding its trailing
+``window`` tokens. Rebuilding that band from pooled KV is inexact (each
+rebuilt position needs its own window of exact hidden states, chaining back
+through every layer), so upstream recomputes the whole prefix on a hit.
+
+The exact alternative is to treat the windowed caches like recurrent state:
+snapshot them at the prefix boundaries the radix tree names (chunk ends and
+mamba-checkpoint-grid points) through the auxiliary-state pool, and restore
+them on an exact-prefix match. The scheduler side then needs the same
+bookkeeping a hybrid SSM model gets (auxiliary-state req-to-token pool,
+MAMBA tree component with the ``no_buffer`` strategy); the predicate below is
+what those sites consult.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+from sglang.srt.hardware_backend.mlx.runtime import use_mlx
+
+
+def config_declares_sliding_window_layers(hf_config: Any) -> bool:
+    """True when the text config lists per-layer ``layer_types`` with at least
+    one ``sliding_attention`` entry and a ``sliding_window`` width -- the
+    container convention ``get_layer_window_sizes`` reads at model load."""
+    if hf_config is None:
+        return False
+    text_config = (
+        hf_config.get_text_config()
+        if hasattr(hf_config, "get_text_config")
+        else hf_config
+    )
+    layer_types = getattr(text_config, "layer_types", None)
+    window = getattr(text_config, "sliding_window", None)
+    if not layer_types or not window:
+        return False
+    return any(layer_type == "sliding_attention" for layer_type in layer_types)
+
+
+def mlx_snapshots_sliding_window_prefix(
+    hf_config: Any, *, disable_radix_cache: bool
+) -> bool:
+    """Whether this server keeps sliding-window prefix state in auxiliary
+    snapshots: MLX backend, radix cache enabled, sliding-window layers declared."""
+    if disable_radix_cache or not use_mlx():
+        return False
+    return config_declares_sliding_window_layers(hf_config)
