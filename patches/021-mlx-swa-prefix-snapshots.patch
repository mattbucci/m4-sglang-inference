+++ b/python/sglang/srt/hardware_backend/mlx/kv_cache/attention_kv_cache.py
@@ -203,11 +203,49 @@ class WindowedAttentionKVCache:
 
     @property
     def state(self):
-        """Arrays for ``mx.eval`` unpacking."""
+        """Arrays for ``mx.eval`` unpacking (the live buffers, no copy)."""
         if self.keys is None:
             return ()
         return (self.keys, self.values)
 
+    @state.setter
+    def state(self, value) -> None:
+        """Install buffers holding exactly the kept trailing window.
+
+        The counterpart of :meth:`snapshot_state`: ``value`` is ``()`` for an
+        empty cache or ``(keys, values)`` with ``kept`` tokens on axis 2. The
+        next :meth:`_append` grows the buffer to its working capacity and
+        copies the window forward, so no capacity is assumed here. ``offset``
+        is restored separately (it is a plain attribute).
+        """
+        if not value:
+            self.keys = None
+            self.values = None
+            self._local = 0
+            return
+        keys, values = value
+        self.keys = keys
+        self.values = values
+        self._local = keys.shape[2]
+
+    def snapshot_state(self):
+        """Compact state for an auxiliary-state snapshot.
+
+        Only the kept trailing window (``min(local, window)`` tokens) can ever
+        be read again, so a prefix snapshot stores just that slice -- about
+        ``2 * window`` tokens less than the live buffer after a prefill
+        chunk. ``state`` keeps returning the live buffers because it is handed
+        to ``mx.async_eval`` every step, where a slice would cost a copy.
+        """
+        if self.keys is None:
+            return ()
+        kept = min(self._local, self.window)
+        start = self._local - kept
+        return (
+            self.keys[:, :, start : self._local, :],
+            self.values[:, :, start : self._local, :],
+        )
+
     def reset(self) -> None:
         """Reset for reuse, keeping allocated buffers."""
         self.offset = 0
