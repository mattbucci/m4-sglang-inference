+class WindowedLookaheadView:
+    """A sliding-window layer cache one token back, read out of the live cache.
+
+    A ``FrozenCacheView`` of that cache holds its buffers, so the next token's
+    write has to copy them, on every chained step. The window the newest token
+    found is still in the live buffer, so this keeps the cache and the offset
+    it had, and reads the window when a snapshot asks for it.
+    """
+
+    __slots__ = ("offset", "_cache")
+
+    def __init__(self, cache: WindowedAttentionKVCache):
+        self.offset = cache.offset
+        self._cache = cache
+
+    @property
+    def state(self):
+        if self._cache.offset != self.offset + 1:
+            raise RuntimeError(
+                "windowed lookahead view read "
+                f"{self._cache.offset - self.offset} tokens after it was taken"
+            )
+        return self._cache.snapshot_state_one_token_back()
+
+
+def lookahead_view(cache: Any) -> FrozenCacheView | WindowedLookaheadView:
+    """The state a layer cache holds now, readable after its next token."""
+    if isinstance(cache, WindowedAttentionKVCache):
+        return WindowedLookaheadView(cache)
+    return FrozenCacheView(cache)
+
+
 def _restore_cache(cache: Any, snapshot: _CacheSnapshot) -> None:
     cache.state = _clone_tree(snapshot.state)
     if snapshot.meta_state is not _MISSING and hasattr(cache, "meta_state"):
