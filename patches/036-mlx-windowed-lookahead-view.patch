+    def snapshot_state_one_token_back(self):
+        """:meth:`snapshot_state` as it was before the newest token was written.
+
+        Valid right after a one-token write. The window that token found sits
+        just before it in the buffer, also when the write compacted: compaction
+        copies the kept window to the buffer start and puts the token after it.
+        """
+        end = self._local - 1
+        kept = min(end, self.window)
+        if kept == 0:
+            return ()
+        return (
+            self.keys[:, :, end - kept : end, :],
+            self.values[:, :, end - kept : end, :],
+        )
+
     def reset(self) -> None:
         """Reset for reuse, keeping allocated buffers."""
         self.offset = 0
