+"""Prompt-lookup drafts for a lone request's decode on the MLX backend.
+
+Opt-in with ``SGLANG_MLX_LOOKUP_DECODE=1``. A coding agent's output repeats
+its own context: a file path it just read, the lines around an edit, a tool
+call's argument names. A lone request therefore guesses its next tokens by
+finding the last few tokens of its context earlier in that context and
+copying what followed there. One forward checks the guess: row ``i`` holds
+the model's distribution after the first ``i`` guessed tokens, and the
+request's own selection rule (arg-max, or its sampler) picks a token from
+each row. The leading guesses that equal their row's pick are kept, one token
+of the model's own follows them, and the rest is rolled back.
+
+Every kept token is what the request's selection rule picks from the model's
+distribution given the tokens before it: greedy text for a greedy request, a
+draw from the same distributions for a sampled one (rows are drawn on
+independent noise; a seeded request reads the noise of its own position, as
+the ordinary loop does). The logits come from a forward of several rows where
+the ordinary loop runs one, and the two round differently in bf16, the way
+two prompt chunk sizes do: greedy text leaves the ordinary loop's only at a
+step whose two best tokens are closer than that noise.
+
+A dense checkpoint pays for a decode step mostly by reading its weights once,
+which is why a forward of two to four rows costs little more than a forward
+of one. An MoE checkpoint routes every row to its own experts and does not
+have that property, so the flag is for dense checkpoints.
+
+This module holds the parts with no MLX state in them: the n-gram index, the
+draft length policy, and the per-request stream. The forward, the rollback
+and the release-time resync live in ``model_runner.py``.
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Any
+
+import msgspec
+
+if TYPE_CHECKING:
+    from sglang.srt.managers.schedule_batch import Req
+
+# Longest match first: a longer match is a better predictor of what follows.
+NGRAMS = (8, 4, 3, 2)
+# How far back a match is measured; the length is a confidence signal.
+MAX_BACK = 64
+# Shortest backward match that earns a draft.
+MIN_BACK = 2
+# A hybrid model replays the tokens a rolled-back forward had accepted. Past
+# this many waiting tokens the next forward only replays, without a draft.
+CARRY_LIMIT = 6
+# Ceiling for the doubling ladder's exponent.
+MAX_LEVEL = 8
+
+
+class NgramIndex:
+    """Most recent earlier occurrence of a growing sequence's last n-gram."""
+
+    __slots__ = ("seq", "_idx", "_reg")
+
+    def __init__(self, seq: list[int]):
+        self.seq = seq
+        # Per n: hash of an n-gram -> the position right after its most
+        # recent occurrence. Hashes keep a deep prompt's index small; a
+        # lookup compares the tokens themselves.
+        self._idx: dict[int, dict[int, int]] = {n: {} for n in NGRAMS}
+        # n-grams ending before this position are registered.
+        self._reg = 0
+
+    def find(self) -> tuple[int | None, int]:
+        """Where the continuation starts, and how long the backward match is.
+
+        Registers every n-gram that ends before the sequence's last token, so
+        the last n-gram never matches itself.
+        """
+        seq = self.seq
+        end = len(seq)
+        reg = self._reg
+        if reg < end - 1:
+            for n in NGRAMS:
+                idx = self._idx[n]
+                for p in range(max(reg, n - 1), end - 1):
+                    idx[hash(tuple(seq[p + 1 - n : p + 1]))] = p + 1
+            self._reg = end - 1
+        for n in NGRAMS:
+            if end < n:
+                continue
+            tail = seq[end - n : end]
+            p = self._idx[n].get(hash(tuple(tail)))
+            if p is None or seq[p - n : p] != tail:
+                continue
+            back = n
+            while (
+                back < MAX_BACK
+                and p - back - 1 >= 0
+                and seq[p - back - 1] == seq[end - back - 1]
+            ):
+                back += 1
+            return p, back
+        return None, 0
+
+
+def draft_rows(*, back: int, level: int, avail: int, max_rows: int) -> int:
+    """Rows to send: 1 is an ordinary step, ``n`` carries ``n - 1`` guesses.
+
+    Two rows after a miss, doubling after every fully kept draft up to
+    ``max_rows``. ``avail`` is how many tokens follow the match.
+    """
+    if avail <= 0 or back < MIN_BACK or max_rows < 2:
+        return 1
+    return max(2, min(max_rows, 2 ** (level + 1), avail + 1))
+
+
+def request_limits(req: Req) -> tuple[frozenset[int], int]:
+    """Stop token ids and the stream length the request may not pass.
+
+    Mirrors ``Req._check_token_based_finish`` and the ``max_new_tokens`` cap,
+    so a draft never runs past a finish the runner can foresee. Any other
+    finish (stop strings, an abort) is caught by the release-time resync.
+    """
+    params = req.sampling_params
+    stop: set[int] = set()
+    if not params.ignore_eos:
+        stop.update(params.stop_token_ids or ())
+        stop.update(req.eos_token_ids or ())
+        if req.tokenizer is not None:
+            if req.tokenizer.eos_token_id is not None:
+                stop.add(req.tokenizer.eos_token_id)
+            stop.update(req.tokenizer.additional_stop_token_ids or ())
+    max_new = params.max_new_tokens
+    limit = len(req.origin_input_ids) + (max_new if max_new is not None else 1 << 30)
+    return frozenset(int(t) for t in stop), limit
+
+
+class LookupStream:
+    """One request's verified tokens and what its drafts are built from.
+
+    ``stream`` is the prompt plus every token a forward has verified. It runs
+    ahead of the tokens the scheduler has been handed by the tokens still
+    queued. ``mark`` is the hybrid rollback point of the newest drafting
+    forward: the cache position before it and a frozen view per recurrent
+    layer.
+    """
+
+    __slots__ = (
+        "stream",
+        "index",
+        "level",
+        "mark",
+        "stop_ids",
+        "limit",
+        "opened_at",
+        "draft_forward_ct",
+        "replay_forward_ct",
+        "plain_forward_ct",
+        "proposed_draft_ct",
+        "correct_draft_ct",
+        "replay_row_ct",
+    )
+
+    def __init__(self, *, tokens: list[int], stop_ids: frozenset[int], limit: int):
+        self.stream = list(tokens)
+        self.index = NgramIndex(self.stream)
+        self.level = 0
+        self.mark: tuple[int, dict[int, Any]] | None = None
+        self.stop_ids = stop_ids
+        self.limit = limit
+        self.opened_at = len(self.stream)
+        # Forwards by kind: with drafts, replay only, ordinary one-row.
+        self.draft_forward_ct = 0
+        self.replay_forward_ct = 0
+        self.plain_forward_ct = 0
+        self.proposed_draft_ct = 0
+        self.correct_draft_ct = 0
+        # Rows a forward ran again after a hybrid's rollback.
+        self.replay_row_ct = 0
+
+    def propose(self, max_rows: int) -> list[int]:
+        """The guess for the tokens after the stream's end; may be empty."""
+        stream = self.stream
+        p, back = self.index.find()
+        if p is None:
+            return []
+        rows = draft_rows(
+            back=back, level=self.level, avail=len(stream) - p, max_rows=max_rows
+        )
+        return self.clip(stream[p : p + rows - 1])
+
+    def clip(self, drafts: list[int]) -> list[int]:
+        """Cut a guess so its forward cannot run past a foreseeable finish."""
+        # The forward emits one token more than it keeps of the drafts.
+        room = self.limit - len(self.stream) - 1
+        drafts = drafts[: max(room, 0)]
+        for i, tok in enumerate(drafts):
+            if tok in self.stop_ids:
+                return drafts[:i]
+        return drafts
+
+    def accept(self, *, drafts: list[int], picks: list[int]) -> int:
+        """Extend the stream by what a forward verified.
+
+        ``picks[i]`` is the model's token after ``drafts[:i]``. Returns the
+        number of correct drafts; the pick after them is the bonus token.
+        """
+        num_correct_drafts = 0
+        while (
+            num_correct_drafts < len(drafts)
+            and picks[num_correct_drafts] == drafts[num_correct_drafts]
+        ):
+            num_correct_drafts += 1
+        self.stream.extend(drafts[:num_correct_drafts])
+        self.stream.append(picks[num_correct_drafts])
+        if drafts:
+            self.draft_forward_ct += 1
+            self.proposed_draft_ct += len(drafts)
+            self.correct_draft_ct += num_correct_drafts
+            all_correct = num_correct_drafts == len(drafts)
+            self.level = min(self.level + 1, MAX_LEVEL) if all_correct else 0
+        else:
+            self.replay_forward_ct += 1
+        return num_correct_drafts
+
+    def summary(self) -> str:
+        tokens = len(self.stream) - self.opened_at
+        return (
+            f"{tokens} tokens from {self.draft_forward_ct} drafting, "
+            f"{self.replay_forward_ct} replay-only and {self.plain_forward_ct} "
+            f"ordinary forwards, {self.correct_draft_ct} of "
+            f"{self.proposed_draft_ct} drafted tokens kept, "
+            f"{self.replay_row_ct} rows replayed"
+        )
+
+
+class LookupStep(msgspec.Struct):
+    """What one decode step of a lookup request did, carried on its pending."""
+
+    state: LookupStream
+    # The token picked from each row of a drafting or replaying forward, from
+    # the row of the stream's newest token on. None for an ordinary one-row step.
+    lazy_rows: Any = None
+    drafts: tuple[int, ...] = ()
+    # The token was verified by an earlier forward; nothing ran.
+    queued: bool = False
