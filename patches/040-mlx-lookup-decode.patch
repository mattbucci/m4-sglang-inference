+    # ------------------------------------------------------------------
+    # Prompt-lookup drafts for a lone request (lookup_decode.py)
+    # ------------------------------------------------------------------
+
+    def _lookup_rows_from_env(self) -> int:
+        """Rows per lookup-decode forward, or 0 when the feature is off."""
+        if not envs.SGLANG_MLX_LOOKUP_DECODE.get():
+            return 0
+        rows = envs.SGLANG_MLX_LOOKUP_DECODE_ROWS.get()
+        reason = None
+        if rows < 2:
+            reason = "SGLANG_MLX_LOOKUP_DECODE_ROWS is below 2"
+        elif self._cache_layout.has_sliding_window_layers:
+            # A windowed cache drops rows as it advances; it cannot be
+            # set back by lowering its offset.
+            reason = "the model has sliding-window attention layers"
+        elif envs.SGLANG_MLX_USE_CUSTOM_ROPE.get():
+            reason = "SGLANG_MLX_USE_CUSTOM_ROPE is set"
+        elif self._sanitize_nan:
+            reason = "SGLANG_SANITIZE_NAN_LOGITS is set"
+        if reason is not None:
+            logger.warning("MLX lookup decode stays off: %s", reason)
+            return 0
+        logger.info(
+            "MLX lookup decode enabled: a lone request drafts up to %d rows "
+            "per forward from its own context",
+            rows,
+        )
+        return rows
+
+    def _lookup_forget(self, req_id: str) -> None:
+        """Drop every lookup record of a request without touching its caches."""
+        self._lookup_close(req_id)
+        self._lookup_limits.pop(req_id, None)
+        self._lookup_off.discard(req_id)
+
+    def _lookup_close(self, req_id: str) -> LookupStream | None:
+        state = self._lookup_state.pop(req_id, None)
+        if state is not None:
+            logger.info("MLX lookup decode, request %s: %s", req_id, state.summary())
+        return state
+
+    def _lookup_open(self, req_id: str) -> LookupStream | None:
+        """The stream for a request's first decode step, if it qualifies."""
+        limits = self._lookup_limits.get(req_id)
+        tokens = self._req_token_ids.get(req_id)
+        cache = self._req_caches.get(req_id)
+        if limits is None or tokens is None or cache is None:
+            return None
+        if self.is_vlm and (
+            self._req_rope_delta.get(req_id) is None
+            or self._position_delta(req_id) != 0
+        ):
+            # mlx_vlm: text prompts on a Qwen-family language model only.
+            return None
+        if any(
+            type(cache[layer_idx]) is not ContiguousAttentionKVCache
+            for layer_idx in self._cache_layout.attention_layer_indices
+        ):
+            return None
+        if self._first_attention_cache(cache).offset != len(tokens) - 1:
+            return None
+        stop_ids, limit = limits
+        return LookupStream(tokens=tokens, stop_ids=stop_ids, limit=limit)
+
+    def _lookup_set_offset(self, *, cache: list[Any], offset: int) -> None:
+        """Shorten the attention caches; rows past the offset are overwritten."""
+        for layer_idx in self._cache_layout.attention_layer_indices:
+            cache[layer_idx].offset = offset
+
+    def _lookup_rewind(
+        self, *, cache: list[Any], mark: tuple[int, dict[int, Any]]
+    ) -> None:
+        """Put a hybrid's caches back to where a drafting forward started."""
+        offset, views = mark
+        for layer_idx, view in views.items():
+            restore_frozen_view(cache=cache[layer_idx], view=view)
+        self._lookup_set_offset(cache=cache, offset=offset)
+
+    def _lookup_forward(
+        self, *, req_id: str, cache: list[Any], rows: list[int], head: bool = True
+    ) -> mx.array | None:
+        """Forward several tokens of one request on its own caches.
+
+        The same call a prompt chunk makes, so positions continue from the
+        cache offset. Returns logits for every row, or nothing useful when
+        ``head`` is False (cache side effects only).
+        """
+        if self._sdpa_block_ladder.enabled:
+            self._sdpa_block_ladder.apply(
+                self._first_attention_cache(cache).offset + len(rows)
+            )
+        self._restore_position_delta(req_id)
+        input_ids = mx.array([rows], dtype=mx.int32)
+        if not head and self._trunk_forward(input_ids, cache) is not None:
+            return None
+        return self._extract_logits(self.model(input_ids, cache=cache))
+
+    def _lookup_select(
+        self, *, req_id: str, rows: mx.array, position: int
+    ) -> mx.array:
+        """One token per row, by the request's own selection rule.
+
+        Row i is the distribution after ``position + i`` tokens. A sampled
+        request draws every row on its own noise (a seeded one on the noise
+        the ordinary loop has at that position), so the draw of a row whose
+        draft prefix was kept is a draw of the ordinary loop.
+        """
+        params = self._req_sampling[req_id] if self._enable_sampling else None
+        if params is None or params.is_greedy:
+            return mx.argmax(rows, axis=-1)
+        n = rows.shape[0]
+        self._rng_key, key = mx.random.split(self._rng_key)
+        return sample_tokens(
+            last_logits=rows,
+            params=[params] * n,
+            positions=[position + i for i in range(n)],
+            key=key,
+        )
+
+    def _lookup_decode_start(
+        self, *, req_ids: list[str], plain_logits: bool
+    ) -> tuple[MlxPendingDecode | None, LookupStream | None]:
+        """One decode step of a lookup request.
+
+        Returns a pending when the step needs no ordinary forward: its token
+        was verified by an earlier forward, or this forward carries a draft
+        or replays tokens a rolled-back forward had kept. Otherwise returns
+        no pending, and the request's stream when the ordinary one-row
+        forward that follows belongs to a lookup request.
+
+        A step of several requests, or one with logit edits, logprobs or a
+        logits hook, ends lookup decode for its requests.
+        """
+        if len(req_ids) != 1 or not plain_logits:
+            for rid in req_ids:
+                self._lookup_leave(rid)
+            return None, None
+        rid = req_ids[0]
+        state = self._lookup_state.get(rid)
+        if state is None:
+            if rid in self._lookup_off:
+                return None, None
+            state = self._lookup_open(rid)
+            if state is None:
+                self._lookup_off.add(rid)
+                return None, None
+            self._lookup_state[rid] = state
+        tokens = self._req_token_ids[rid]
+        cache = self._req_caches[rid]
+        stream = state.stream
+        if len(tokens) < len(stream):
+            return (
+                MlxPendingDecode(
+                    lazy_tokens=mx.array([stream[len(tokens)]], dtype=mx.uint32),
+                    req_ids=[rid],
+                    caches=[cache],
+                    no_chain=True,
+                    lookup=LookupStep(state=state, queued=True),
+                ),
+                state,
+            )
+        # Every verified token has been handed out, so the caches hold no
+        # row past the stream and the last rollback point is spent.
+        state.mark = None
+        consumed = self._first_attention_cache(cache).offset
+        inputs = stream[consumed:]
+        if not inputs:
+            self._lookup_leave(rid)
+            return None, None
+        drafts = state.propose(self._lookup_rows) if len(inputs) <= CARRY_LIMIT else []
+        if not drafts and len(inputs) == 1:
+            return None, state
+        if drafts and self._has_snapshot_state:
+            # Recurrent layers cannot be shortened: keep the state this
+            # forward starts from, to restart from it if a draft is wrong.
+            state.mark = (
+                consumed,
+                {
+                    layer_idx: FrozenCacheView(cache[layer_idx])
+                    for layer_idx in self._snapshot_layer_indices
+                },
+            )
+        logits = self._lookup_forward(req_id=rid, cache=cache, rows=inputs + drafts)
+        base = len(inputs) - 1
+        state.replay_row_ct += base
+        lazy_rows = self._lookup_select(
+            req_id=rid, rows=logits[0, base:, :], position=consumed + base
+        )
+        return (
+            MlxPendingDecode(
+                lazy_tokens=lazy_rows[:1],
+                req_ids=[rid],
+                caches=[cache],
+                no_chain=True,
+                lookup=LookupStep(
+                    state=state, lazy_rows=lazy_rows, drafts=tuple(drafts)
+                ),
+            ),
+            state,
+        )
+
