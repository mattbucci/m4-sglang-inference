diff --git a/python/sglang/_platform_stubs.py b/python/sglang/_platform_stubs.py
index 90d8c1d3e4..15f687215e 100644
--- a/python/sglang/_platform_stubs.py
+++ b/python/sglang/_platform_stubs.py
@@ -362,16 +362,27 @@ def _patch_non_blocking() -> None:
 
     @functools.wraps(_original_to)
     def _patched_to(self, *args, **kwargs):
-        if kwargs.get("non_blocking"):
-            # Detect target device from positional or keyword args
-            device = None
-            if args and isinstance(args[0], (str, torch.device)):
-                device = torch.device(args[0]) if isinstance(args[0], str) else args[0]
-            elif "device" in kwargs:
-                d = kwargs["device"]
-                device = torch.device(d) if isinstance(d, str) else d
-            if device is not None and device.type == "mps":
+        # Detect target device from positional or keyword args.
+        device = None
+        if args and isinstance(args[0], (str, torch.device)):
+            device = torch.device(args[0]) if isinstance(args[0], str) else args[0]
+        elif "device" in kwargs:
+            d = kwargs["device"]
+            device = torch.device(d) if isinstance(d, str) else d
+
+        if device is not None:
+            if device.type == "cuda":
+                # No CUDA on Apple Silicon. Redirect cuda→cpu so SGLang's
+                # multimodal image processor (and other transformers code
+                # defaulting to .to('cuda')) keeps working without crashing
+                # in CUDA's _lazy_init.
+                if args and isinstance(args[0], (str, torch.device)):
+                    args = ("cpu",) + args[1:]
+                else:
+                    kwargs = {**kwargs, "device": "cpu"}
+            elif device.type == "mps" and kwargs.get("non_blocking"):
                 kwargs = {**kwargs, "non_blocking": False}
+
         return _original_to(self, *args, **kwargs)
 
     torch.Tensor.to = _patched_to
diff --git a/python/sglang/srt/managers/mm_utils.py b/python/sglang/srt/managers/mm_utils.py
index bac20d0750..5f6e3db6fc 100644
--- a/python/sglang/srt/managers/mm_utils.py
+++ b/python/sglang/srt/managers/mm_utils.py
@@ -1384,7 +1384,11 @@ class ShmPointerMMData:
                 # the process is killed with SIGBUS. Reserving the pages up
                 # front turns exhaustion into a catchable OSError (ENOSPC).
                 os.posix_fallocate(shm._fd, 0, nbytes)
-            dst = torch.frombuffer(shm.buf, dtype=torch.uint8)
+            # macOS rounds shm allocations up to a page (16 KB on Apple
+            # Silicon), so torch.frombuffer(shm.buf, ...) returns a
+            # tensor LARGER than nbytes. dst.copy_(src) then fails the
+            # size match. Slice dst to the logical byte count.
+            dst = torch.frombuffer(shm.buf, dtype=torch.uint8)[:nbytes]
             dst.copy_(tensor.view(torch.uint8).reshape(-1))
         except BaseException:
             shm.close()
@@ -1416,7 +1420,13 @@ class ShmPointerMMData:
         try:
             handle = shared_memory.SharedMemory(name=self.shm_name)
             tensor = torch.frombuffer(handle.buf, dtype=self.dtype)
-            self.tensor = tensor.reshape(self.shape)
+            # macOS rounds shm allocations up to a page so the buffer is
+            # larger than self.shape implies. Slice to logical element count
+            # before reshape — mirrors the write-side fix above.
+            n_elements = 1
+            for d in self.shape:
+                n_elements *= d
+            self.tensor = tensor[:n_elements].reshape(self.shape)
             self._shm_handle = handle
         except Exception as error:
             tensor = None
