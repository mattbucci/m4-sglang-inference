diff --git a/python/sglang/srt/hardware_backend/mlx/sdpa_blocks.py b/python/sglang/srt/hardware_backend/mlx/sdpa_blocks.py
new file mode 100644
index 0000000000..7ab5589b64
--- /dev/null
+++ b/python/sglang/srt/hardware_backend/mlx/sdpa_blocks.py
@@ -0,0 +1,87 @@
+"""Depth-aware block count for MLX's two-pass decode attention kernel.
+
+One decode query against N cached keys runs MLX's vector SDPA kernel: a first
+pass splits the keys into ``blocks`` interleaved slices, one threadgroup each,
+and a second pass reduces the partials. MLX picks ``blocks`` from N on a ladder
+that stops at 1024. Evaluated one layer at a time, the way a decode step meets
+its attention layers, the first pass holds its byte rate (190-200 GB/s on an
+M4 Pro) while a slice has at most about 192 keys; past that the rate falls
+with depth (about 160 GB/s at 262,144 keys).
+
+MLX reads ``MLX_SDPA_BLOCKS`` on every kernel call, so the count can follow the
+cached length. Past ``STOCK_MAX_KEYS`` this module asks for 512 blocks per
+65,536 keys, which keeps a slice at 128 keys or fewer. Several kernels queued
+back to back lose more on large slices than a serving step does, so a raw
+benchmark that evaluates all layers at once overstates the gain and puts the
+crossover too early.
+
+The variable is process-wide and applies to every two-pass call encoded while
+it is set. A block count only changes the order partial sums are reduced in,
+so any value is correct; it is still installed only for models whose attention
+layers all read the full context, because a sliding-window layer would be cut
+into slices of a few keys.
+"""
+
+from __future__ import annotations
+
+import logging
+import math
+import os
+
+logger = logging.getLogger(__name__)
+
+ENV = "MLX_SDPA_BLOCKS"
+# MLX's own ladder is as fast or faster up to here (1024 blocks, <= 192 keys).
+STOCK_MAX_KEYS = 196_608
+BLOCK_STEP = 512
+KEYS_PER_STEP = 65_536
+
+
+def blocks_for(n_keys: int) -> int:
+    """Block count to request for ``n_keys`` cached keys; 0 keeps MLX's ladder."""
+    if n_keys <= STOCK_MAX_KEYS:
+        return 0
+    return BLOCK_STEP * math.ceil(n_keys / KEYS_PER_STEP)
+
+
+class SdpaBlockLadder:
+    """Keeps ``MLX_SDPA_BLOCKS`` in step with the deepest decode in a batch.
+
+    ``apply`` runs while a decode step's graph is built, before the step is
+    handed to ``mx.async_eval``; MLX encodes the step on that same thread, so
+    the kernel call sees the value set for its own step. A value the operator
+    set before launch is a pin and is left alone.
+    """
+
+    def __init__(self, enabled: bool):
+        self._pinned = os.environ.get(ENV)
+        self._enabled = bool(enabled) and self._pinned is None
+        self._current = 0
+        if enabled and self._pinned is not None:
+            logger.info(
+                "%s=%s is set; the depth-aware SDPA block ladder stays off",
+                ENV,
+                self._pinned,
+            )
+
+    @property
+    def enabled(self) -> bool:
+        return self._enabled
+
+    def apply(self, n_keys: int) -> int:
+        """Set the variable for ``n_keys``; returns the count in force (0 = stock)."""
+        if not self._enabled:
+            return 0
+        want = blocks_for(n_keys)
+        if want != self._current:
+            if want:
+                os.environ[ENV] = str(want)
+            else:
+                os.environ.pop(ENV, None)
+            logger.info(
+                "SDPA block ladder: %d keys -> %s",
+                n_keys,
+                f"{want} blocks" if want else "MLX's own ladder",
+            )
+            self._current = want
+        return want
