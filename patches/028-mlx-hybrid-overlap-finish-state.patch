+class FrozenCacheView:
+    """What ``_snapshot_cache`` reads from a layer cache, pinned at one moment.
+
+    Holds array handles only (no data copies, no evaluation), so taking one
+    per snapshot layer before a chained decode step costs a few small
+    allocations. The model then rebinds or overwrites the live cache's
+    entries with the next step's lazy arrays while this view keeps the state
+    the step was built on.
+    """
+
+    def __init__(self, cache: Any):
+        if hasattr(cache, "snapshot_state"):
+            self.state = _clone_tree(cache.snapshot_state())
+        else:
+            self.state = _clone_tree(getattr(cache, "state", ()))
+        if hasattr(cache, "meta_state"):
+            self.meta_state = _clone_tree(cache.meta_state)
+        for name in _CACHE_ATTRS:
+            if hasattr(cache, name):
+                setattr(self, name, _clone_tree(getattr(cache, name)))
+
+
 def _restore_cache(cache: Any, snapshot: _CacheSnapshot) -> None:
     cache.state = _clone_tree(snapshot.state)
     if snapshot.meta_state is not _MISSING and hasattr(cache, "meta_state"):
