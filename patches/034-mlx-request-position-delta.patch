+    def _keep_position_delta(self, req_id: str) -> None:
+        """Remember the mRoPE delta ``req_id``'s prompt left on the language model.
+
+        mlx_vlm's Qwen-family language models number every token forwarded on
+        a cache with history as ``cache offset + _rope_deltas``, and
+        ``_rope_deltas`` is one field on the model: zero after a text prompt,
+        negative after an image (its tokens share positions). Each prefill
+        overwrites it, so with two live requests the one that prefilled first
+        would have its later tokens numbered with the other's delta. The
+        runner keeps the delta per request and puts it back before each of
+        the request's forwards.
+        """
+        if not self.is_vlm:
+            return
+        lm = getattr(self.model, "language_model", None)
+        delta = getattr(lm, "_rope_deltas", None)
+        if delta is not None:
+            self._req_rope_delta[req_id] = delta
+
+    def _restore_position_delta(self, req_id: str) -> None:
+        """Put ``req_id``'s mRoPE delta back on the language model.
+
+        Nothing to do while the model still holds it, which is always so with
+        one live request.
+        """
+        delta = self._req_rope_delta.get(req_id) if self.is_vlm else None
+        if delta is None:
+            return
+        lm = self.model.language_model
+        if lm._rope_deltas is not delta:
+            lm._rope_deltas = delta
+
+    def _forward_lazy_token(self, input_ids, cache, needs_logits, req_id, *args, **kw):
+        """``_forward_prompt_chunk``, then keep the request's mRoPE delta."""
+        out = self._forward_prompt_chunk(
+            input_ids, cache, needs_logits, req_id, *args, **kw
+        )
+        self._keep_position_delta(req_id)
+        return out
+
