+    def _mrope_decode(
+        self,
+        queries: mx.array,
+        keys: mx.array,
+        values: mx.array,
+        gate: Optional[mx.array],
+        ctx: BatchedDecodeContext,
+    ) -> mx.array:
+        """One decode step of B requests on an mRoPE attention layer.
+
+        Each request attends over its own cache: one SDPA launch per request
+        on the buffer the cache already holds. Padding the caches into one
+        ragged batch would copy every request's whole context on every step,
+        which costs more than the launches it saves once contexts are long.
+        """
+        inner = self._inner
+        B = ctx.batch_size
+        queries, keys = self._mrope.apply_rotary(
+            queries, keys, ctx.mrope_position_ids(), unsqueeze_dim=1
+        )
+        layer_caches = ctx.attention_layer_caches[
+            ctx.attention_pool_index_by_layer[self._layer_idx]
+        ]
+        window = self._window_size
+        outputs = []
+        for i in range(B):
+            layer_caches[i].write_token(keys[i : i + 1], values[i : i + 1])
+            k_all, v_all = layer_caches[i].get_kv(window)
+            outputs.append(
+                mx.fast.scaled_dot_product_attention(
+                    queries[i : i + 1],
+                    k_all,
+                    v_all,
+                    scale=self._scale,
+                    mask=None,
+                    **self._sink_kwargs,
+                )
+            )
+        output = mx.concatenate(outputs, axis=0)
+        output = output.transpose(0, 2, 1, 3).reshape(B, 1, -1)
+        if gate is not None:
+            output = output * mx.sigmoid(gate)
+        return inner.o_proj(output)
+
