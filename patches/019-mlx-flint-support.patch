diff --git a/python/sglang/srt/hardware_backend/mlx/text_checkpoint.py b/python/sglang/srt/hardware_backend/mlx/text_checkpoint.py
new file mode 100644
index 0000000000..060301b158
--- /dev/null
+++ b/python/sglang/srt/hardware_backend/mlx/text_checkpoint.py
@@ -0,0 +1,109 @@
+"""mlx-lm text-model loading that accepts mlx-vlm's checkpoint layout."""
+
+from __future__ import annotations
+
+import logging
+from pathlib import Path
+from typing import Any
+
+import mlx.core as mx
+from mlx.utils import tree_flatten
+from mlx_lm.utils import _get_classes
+from mlx_lm.utils import load_model as mlx_lm_load_model
+
+logger = logging.getLogger(__name__)
+
+# mlx-vlm wraps a text model as ``Model.language_model``; quantizers that go
+# through its model class (oMLX's oQ series, ...) save a text-only checkpoint
+# with every tensor and per-tensor quantization override under this prefix,
+# which mlx-lm's own model classes do not expect.
+VLM_TEXT_PREFIX = "language_model."
+# mlx-vlm synthesizes a zero DeepSeek-style routing bias for Flint MoE blocks
+# and saves it; mlx-lm's Flint routes without one.
+_SYNTHESIZED_ZERO_SUFFIXES = (".mlp.expert_bias",)
+
+
+def _strip_prefix(name: str) -> str:
+    if name.startswith(VLM_TEXT_PREFIX):
+        return name[len(VLM_TEXT_PREFIX) :]
+    return name
+
+
+def _strip_quantization_keys(config: dict) -> None:
+    """Rename per-tensor quantization overrides to match the stripped weights."""
+    for key in ("quantization", "quantization_config"):
+        section = config.get(key)
+        if isinstance(section, dict):
+            config[key] = {_strip_prefix(k): v for k, v in section.items()}
+
+
+def _drop_synthesized_zero_params(model: Any, weights: dict) -> dict:
+    """Drop all-zero tensors the model declares no parameter for.
+
+    Only the known synthesized names qualify; any other unexpected tensor is
+    left for ``load_weights(strict=True)`` to report.
+    """
+    expected = {name for name, _ in tree_flatten(model.parameters())}
+    dropped = []
+    for name in list(weights):
+        if name in expected or not name.endswith(_SYNTHESIZED_ZERO_SUFFIXES):
+            continue
+        if mx.any(weights[name] != 0).item():
+            raise ValueError(
+                f"checkpoint tensor {name} is not a parameter of "
+                f"{type(model).__name__} and is not all-zero; refusing to drop it"
+            )
+        del weights[name]
+        dropped.append(name)
+    if dropped:
+        logger.info(
+            "Dropped %d all-zero checkpoint tensors without a model parameter "
+            "(e.g. %s)",
+            len(dropped),
+            dropped[0],
+        )
+    return weights
+
+
+def _adapt_model_class(model_class: type, config: dict) -> type:
+    """Subclass whose ``sanitize`` accepts mlx-vlm's text-checkpoint layout."""
+
+    class _AdaptedModel(model_class):
+        def sanitize(self, weights):
+            if not hasattr(self, "language_model") and any(
+                k.startswith(VLM_TEXT_PREFIX) for k in weights
+            ):
+                weights = {_strip_prefix(k): v for k, v in weights.items()}
+                _strip_quantization_keys(config)
+                logger.info(
+                    "Stripped the %r prefix from %d checkpoint tensors",
+                    VLM_TEXT_PREFIX,
+                    len(weights),
+                )
+            if hasattr(model_class, "sanitize"):
+                weights = super().sanitize(weights)
+            return _drop_synthesized_zero_params(self, weights)
+
+    _AdaptedModel.__name__ = model_class.__name__
+    _AdaptedModel.__qualname__ = model_class.__qualname__
+    _AdaptedModel.__module__ = model_class.__module__
+    return _AdaptedModel
+
+
+def load_text_model(model_dir: Path, trust_remote_code: bool) -> tuple[Any, dict]:
+    """Load a text checkpoint through mlx-lm; returns ``(model, config)``.
+
+    The config dict handed to ``get_model_classes`` is the one mlx-lm later
+    reads its per-tensor quantization overrides from, so the adapted
+    ``sanitize`` can rename those keys in place alongside the weights.
+    """
+
+    def get_model_classes(config: dict):
+        model_class, model_args_class = _get_classes(config)
+        return _adapt_model_class(model_class, config), model_args_class
+
+    return mlx_lm_load_model(
+        Path(model_dir),
+        get_model_classes=get_model_classes,
+        trust_remote_code=trust_remote_code,
+    )
