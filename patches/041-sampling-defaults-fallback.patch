+# The keys get_default_sampling_params reads from a generation config.
+_SAMPLING_DEFAULT_KEYS = (
+    "repetition_penalty",
+    "temperature",
+    "top_k",
+    "top_p",
+    "min_p",
+)
+
+
+def _parse_sampling_defaults_fallback(
+    fallback: Union[str, dict[str, Any], None],
+) -> dict[str, Any]:
+    if not fallback:
+        return {}
+    params = json.loads(fallback) if isinstance(fallback, str) else dict(fallback)
+    unknown = sorted(set(params) - set(_SAMPLING_DEFAULT_KEYS))
+    if unknown:
+        raise ValueError(
+            f"--sampling-defaults-fallback: unsupported keys {unknown}, "
+            f"expected a subset of {list(_SAMPLING_DEFAULT_KEYS)}"
+        )
+    return params
+
