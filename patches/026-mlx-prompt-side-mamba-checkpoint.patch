+    def _publish_prompt_side_mamba_checkpoint(self, req: Req) -> None:
+        """Keep the MLX runner's prompt-side auxiliary checkpoint next to the
+        end-of-generation state the final insert donates. A follow-up turn
+        re-renders the history through the chat template and diverges inside
+        the generation tail (Qwen3.x: 1-2 tokens before the primed prompt end),
+        so the end state never serves it and the tail of the last prefill
+        chunk would be recomputed on every agentic turn."""
+        if not use_mlx() or not self.tree_cache.supports_mamba():
+            return
+        if req.skip_radix_cache_insert or req.kv.mamba_ping_pong_track_buffer is None:
+            return
+        track_len = req.kv.mamba_last_track_seqlen
+        if track_len is None or len(req.output_ids) <= 1:
+            return
+        if not (req.kv.cache_protected_len < track_len < req.owned_kv_len()):
+            return
+        req.refresh_fill_ids()
+        self.tree_cache.checkpoint_into_tree(req, up_to=track_len, as_running=True)
