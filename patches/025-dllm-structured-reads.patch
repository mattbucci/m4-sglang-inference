+def _validate_diffusion_options(opts: dict, req) -> Optional[str]:
+    """Structured-read options: shapes against the served canvas."""
+    block_size = req.dllm_config.block_size
+    if req.dllm_config.first_done_first_out_mode:
+        return "diffusion options need the synchronous loop (no --dllm-fdfo)"
+    unknown = set(opts) - {"seed_canvas", "pinned", "max_steps", "read_only", "constrained"}
+    if unknown:
+        return f"unknown diffusion options {sorted(unknown)}"
+    canvas = opts.get("seed_canvas")
+    if canvas is not None and (
+        not isinstance(canvas, list)
+        or len(canvas) != block_size
+        or any(type(t) is not int or t < 0 for t in canvas)
+    ):
+        return f"diffusion.seed_canvas must be {block_size} non-negative token ids"
+    pinned = opts.get("pinned")
+    if pinned is not None and (
+        not isinstance(pinned, list)
+        or any(type(p) is not int or not 0 <= p < block_size for p in pinned)
+    ):
+        return f"diffusion.pinned must be canvas positions in [0, {block_size})"
+    if pinned and canvas is None:
+        return "diffusion.pinned needs diffusion.seed_canvas"
+    steps = opts.get("max_steps")
+    if steps is not None and (type(steps) is not int or steps < 1):
+        return "diffusion.max_steps must be a positive integer"
+    if opts.get("constrained") and not (req.return_logprob and req.logprob.token_ids_logprob):
+        return "diffusion.constrained needs return_logprob with token_ids_logprob"
+    return None
+
